#!/usr/bin/env bash
set -uo pipefail

added="$(git diff --cached --unified=0 --no-color -- . \
  | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"

[ -n "$added" ] || exit 0

scan() {
  local label="$1" regex="$2" hit
  hit="$(printf '%s\n' "$added" | grep -nEi -e "$regex" || true)"
  [ -n "$hit" ] || return 0
  echo "  [$label]"
  printf '%s\n' "$hit" | sed 's/^/      /'
  return 1
}

failed=0

scan "GitHub token"      'gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,}' || failed=1
scan "Anthropic key"     'sk-ant-[A-Za-z0-9_-]{20,}'                               || failed=1
scan "OpenAI key"        'sk-(proj-)?[A-Za-z0-9]{32,}'                             || failed=1
scan "Slack token"       'xox[baprs]-[A-Za-z0-9-]{10,}'                            || failed=1
scan "GitLab token"      'glpat-[A-Za-z0-9_-]{16,}'                                || failed=1
scan "Google API key"    'AIza[0-9A-Za-z_-]{35}'                                   || failed=1
scan "AWS access key"    'AKIA[0-9A-Z]{16}'                                        || failed=1
scan "private key"       '-----BEGIN [A-Z ]*PRIVATE KEY-----'                      || failed=1
scan "npm auth token"    '_authToken[[:space:]]*=[[:space:]]*[^$[:space:]]'         || failed=1
scan "bearer token"      'authorization:[[:space:]]*bearer[[:space:]]+[A-Za-z0-9._-]{16,}' || failed=1
scan "inline secret"     '(api[_-]?key|client[_-]?secret|access[_-]?token|password)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_/+=-]{12,}' || failed=1

if [ "$failed" -ne 0 ]; then
  cat >&2 <<'EOF'

pre-commit: the staged changes look like they contain a credential.

This repository is public, and a pushed secret stays in the history even after
you delete it, so rotate anything that has already left the machine.

If this is a false positive, commit once with:
  git commit --no-verify
EOF
  exit 1
fi

exit 0
