#!/usr/bin/env bash
pane="$(tmux list-panes -t "$1" -F '#{pane_id} #{@cctask_role} #{pane_current_command}' 2>/dev/null \
  | awk '$2 == "claude" || $3 == "claude" { print $1; exit }')"
[ -n "$pane" ] || exit 0
if tmux capture-pane -t "$pane" -p -J -S -20 2>/dev/null \
  | grep -qiE 'waiting for [0-9]+ background agent|to interrupt|thinking|ctrl\+b to run in background'; then
  s='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  printf ' #[fg=#f6c177]%s' "${s:$(( $(date +%s) % 10 )):1}"
else
  printf ' #[fg=#6e6a86]●'
fi
