#!/usr/bin/env bash
load="$(sysctl -n vm.loadavg | awk '{ printf "%.1f", $2 }')"
used="$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/ { gsub(/[^0-9]/, "", $2); print 100 - $2 }')"
ge="$(TZ=Asia/Tbilisi date +%H:%M)"
tw="$(TZ=Asia/Taipei date +%H:%M)"
h="$(TZ=Asia/Taipei date +%H)"
case "$h" in
  09|10|11|12|13|14|15|16|17) tw_fg='#9ccfd8' ;;
  *) tw_fg='#6e6a86' ;;
esac
mem=
[ -n "$used" ] && mem=" #[fg=#6e6a86]mem #[fg=#b4b1c8]${used}%"
usage="$(cat "${XDG_CACHE_HOME:-$HOME/.cache}/tmux-claude-usage" 2>/dev/null || true)"
[ -n "$usage" ] && usage=" $usage"
printf '#[fg=#6e6a86]load #[fg=#b4b1c8]%s%s%s  #[fg=#6e6a86]GE #[fg=#b4b1c8]%s  #[fg=%s]TW %s' \
  "$load" "$mem" "$usage" "$ge" "$tw_fg" "$tw"
