#!/usr/bin/env bash
role="$1"
cmd="$2"
case "$role" in
  editor) pane=nvim ;;
  claude) pane=claude ;;
  shell) pane=shell ;;
  *)
    case "$cmd" in
      nvim|vim) pane=nvim ;;
      claude) pane=claude ;;
      zsh|bash|fish|sh) pane=shell ;;
      *) pane="${cmd:-pane}" ;;
    esac
    ;;
esac

load="$(sysctl -n vm.loadavg 2>/dev/null | awk '{ printf "%.1f", $2 }')"
used="$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/ { gsub(/[^0-9]/, "", $2); print 100 - $2 }')"
ge="$(TZ=Asia/Tbilisi date +%H:%M)"
tw="$(TZ=Asia/Taipei date +%H:%M)"
h="$(TZ=Asia/Taipei date +%H)"

gap='#[bg=#232136] '
pine='#[fg=#232136,bg=#3e8fb0]'
gold='#[fg=#232136,bg=#f6c177]'
foam='#[fg=#232136,bg=#9ccfd8]'
iris='#[fg=#232136,bg=#c4a7e7,bold]'

warn() {
  if [ -n "$1" ] && [ "$1" -ge 80 ] 2>/dev/null; then
    printf '#[fg=#eb6f92,bg=#f6c177]'
  elif [ -n "$1" ] && [ "$1" -ge 50 ] 2>/dev/null; then
    printf '#[fg=#b4637a,bg=#f6c177]'
  else
    printf '%s' "$gold"
  fi
}

host="${pine} 󰘚 ${load}"
[ -n "$used" ] && host="${host} · 󰍛 ${used}%"
host="${host} "

ctx= h5= d7=
cache="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-claude-usage"
if [ -f "$cache" ]; then
  eval "$(grep -E '^(ctx|h5|d7)=' "$cache" 2>/dev/null)"
fi
usage_chip=
bits=
[ -n "$ctx" ] && bits="${bits} $(warn "$ctx")󰧑 ${ctx}%"
[ -n "$h5" ] && bits="${bits} $(warn "$h5")󰔛 ${h5}%"
[ -n "$d7" ] && bits="${bits} $(warn "$d7")󰨳 ${d7}%"
[ -n "$bits" ] && usage_chip="${gap}${gold}${bits} "

case "$h" in
  09|10|11|12|13|14|15|16|17) twc='#[fg=#286983,bg=#9ccfd8,bold]' ;;
  *) twc="$foam" ;;
esac
clocks="${foam} GE ${ge} · ${twc}TW ${tw} "

printf '%s%s%s%s%s%s' "$host" "$usage_chip" "$gap" "$clocks" "$gap" "${iris} ${pane} "
