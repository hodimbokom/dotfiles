#!/usr/bin/env bash
# Hide or show a cctask pane. Role is "shell" (bottom-right) or "editor" (nvim, left).
set -euo pipefail

win="${1:-}"
role="${2:-shell}"
[ -n "$win" ] || win="$(tmux display-message -p '#{window_id}')"

case "$role" in
  shell|editor) ;;
  *) tmux display-message "cctask-toggle-pane: role must be shell or editor"; exit 1 ;;
esac

hidden_opt="@cctask_${role}_hidden"
hidden="$(tmux show-options -wv -t "$win" "$hidden_opt" 2>/dev/null || true)"

pane_by_role() {
  tmux list-panes -t "$win" -F '#{pane_id} #{@cctask_role}' \
    | awk -v r="$1" '$2 == r { print $1; exit }'
}

find_pane() {
  local p
  p="$(pane_by_role "$role")"
  [ -n "$p" ] && { echo "$p"; return; }
  case "$role" in
    shell)
      tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_bottom} #{pane_at_right}' \
        | awk '$2 == 0 && $3 == 1 && $4 == 1 { print $1; exit }'
      ;;
    editor)
      tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_left} #{pane_at_right} #{pane_at_top} #{pane_at_bottom}' \
        | awk '$2 == 1 && $3 == 0 && $4 == 1 && $5 == 1 { print $1; exit }'
      ;;
  esac
}

claude_pane() {
  local p
  p="$(pane_by_role claude)"
  [ -n "$p" ] && { echo "$p"; return; }
  tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_right}' \
    | awk '$2 == 1 && $3 == 1 { print $1; exit }'
}

stow_hidden() {
  local pane="$1" hid
  tmux has-session -t=_cctask_hidden 2>/dev/null \
    || tmux new-session -d -s _cctask_hidden -n _dummy
  hid="$(tmux break-pane -d -P -F '#{window_id}' -s "$pane")"
  tmux move-window -d -s "$hid" -t =_cctask_hidden:
  tmux kill-window -t =_cctask_hidden:_dummy 2>/dev/null || true
  tmux set-option -w -t "$win" "$hidden_opt" "$hid"
}

# If this role is already stowed, always restore. Do not hunt for another pane to hide.
if [ -n "$hidden" ]; then
  target="$(claude_pane)"
  [ -n "$target" ] || { tmux display-message "no pane to restore $role into"; exit 1; }
  case "$role" in
    shell)
      tmux join-pane -v -l 25% -s "$hidden" -t "$target"
      ;;
    editor)
      tmux join-pane -h -b -f -l 50% -s "$hidden" -t "$target"
      ;;
  esac
  tmux set-option -wu -t "$win" "$hidden_opt"
  new="$(find_pane)"
  [ -n "$new" ] && tmux set-option -p -t "$new" @cctask_role "$role"
  exit 0
fi

pane="$(find_pane)"
if [ -n "$pane" ]; then
  count="$(tmux list-panes -t "$win" | wc -l | tr -d ' ')"
  if [ "$count" -le 1 ]; then
    tmux display-message "cannot hide the last pane"
    exit 1
  fi
  stow_hidden "$pane"
  exit 0
fi

tmux display-message "no $role pane to toggle"
