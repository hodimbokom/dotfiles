#!/usr/bin/env bash
# Hide or show the bottom-right shell in a cctask window. Bound to prefix+t.
set -euo pipefail

win="${1:-}"
[ -n "$win" ] || win="$(tmux display-message -p '#{window_id}')"
hidden="$(tmux show-options -wv -t "$win" @cctask_shell_hidden 2>/dev/null || true)"

pane_by_role() {
  tmux list-panes -t "$win" -F '#{pane_id} #{@cctask_role}' \
    | awk -v r="$1" '$2 == r { print $1; exit }'
}

shell_pane() {
  local p
  p="$(pane_by_role shell)"
  [ -n "$p" ] && { echo "$p"; return; }
  tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_bottom} #{pane_at_right}' \
    | awk '$2 == 0 && $3 == 1 && $4 == 1 { print $1; exit }'
}

claude_pane() {
  local p
  p="$(pane_by_role claude)"
  [ -n "$p" ] && { echo "$p"; return; }
  tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_right}' \
    | awk '$2 == 1 && $3 == 1 { print $1; exit }'
}

shell="$(shell_pane)"
if [ -n "$shell" ]; then
  tmux has-session -t=_cctask_hidden 2>/dev/null \
    || tmux new-session -d -s _cctask_hidden -n _dummy
  hid="$(tmux break-pane -d -P -F '#{window_id}' -s "$shell")"
  tmux move-window -d -s "$hid" -t =_cctask_hidden:
  tmux kill-window -t =_cctask_hidden:_dummy 2>/dev/null || true
  tmux set-option -w -t "$win" @cctask_shell_hidden "$hid"
  exit 0
fi

if [ -n "$hidden" ]; then
  target="$(claude_pane)"
  [ -n "$target" ] || { tmux display-message "no pane to restore the shell into"; exit 1; }
  tmux join-pane -v -l 50% -s "$hidden" -t "$target"
  tmux set-option -wu -t "$win" @cctask_shell_hidden
  new="$(shell_pane)"
  [ -n "$new" ] && tmux set-option -p -t "$new" @cctask_role shell
  exit 0
fi

tmux display-message "no shell pane to toggle"
