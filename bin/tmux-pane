#!/usr/bin/env bash
set -euo pipefail

win="${1:-$(tmux display-message -p '#{window_id}')}"
role="${2:-shell}"
case "$role" in
  shell|editor|claude) ;;
  *) tmux display-message "tmux-pane: shell, editor or claude"; exit 1 ;;
esac

opt="@cctask_${role}_hidden"
hidden="$(tmux show-options -wv -t "$win" "$opt" 2>/dev/null || true)"

pane() {
  tmux list-panes -t "$win" -F '#{pane_id} #{@cctask_role}' | awk -v r="$1" '$2 == r { print $1; exit }'
}

layout_pane() {
  case "$1" in
    shell) tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_bottom} #{pane_at_left}' | awk '$2==0 && $3==1 && $4==1 {print $1; exit}' ;;
    editor) tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_left} #{pane_at_right} #{pane_at_top}' | awk '$2==1 && $3==0 && $4==1 {print $1; exit}' ;;
    claude) tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_right}' | awk '$2==1 && $3==1 {print $1; exit}' ;;
  esac
}

find_pane() {
  local p
  p="$(pane "$1")"
  [ -n "$p" ] && { echo "$p"; return; }
  layout_pane "$1"
}

if [ -n "$hidden" ]; then
  case "$role" in
    shell)
      target="$(pane editor)"
      [ -n "$target" ] || target="$(find_pane claude)"
      [ -n "$target" ] || { tmux display-message "no pane to restore shell into"; exit 1; }
      tmux join-pane -v -l 30% -s "$hidden" -t "$target"
      ;;
    editor)
      target="$(pane shell)"
      if [ -n "$target" ]; then
        tmux join-pane -v -b -l 70% -s "$hidden" -t "$target"
      else
        target="$(find_pane claude)"
        [ -n "$target" ] || { tmux display-message "no pane to restore editor into"; exit 1; }
        tmux join-pane -h -b -f -l 50% -s "$hidden" -t "$target"
      fi
      ;;
    claude)
      target="$(pane editor)"
      [ -n "$target" ] || target="$(pane shell)"
      [ -n "$target" ] || { tmux display-message "no pane to restore claude into"; exit 1; }
      tmux join-pane -h -f -l 50% -s "$hidden" -t "$target"
      ;;
  esac
  tmux set-option -wu -t "$win" "$opt"
  new="$(find_pane "$role")"
  [ -n "$new" ] && tmux set-option -p -t "$new" @cctask_role "$role"
  exit 0
fi

cur="$(find_pane "$role")"
[ -n "$cur" ] || { tmux display-message "no $role pane to toggle"; exit 1; }
count="$(tmux list-panes -t "$win" -F '#{pane_id}' | grep -c .)"
if [ "$count" -le 1 ]; then
  tmux display-message "cannot hide the last pane"
  exit 1
fi

tmux has-session -t=_cctask_hidden 2>/dev/null || tmux new-session -d -s _cctask_hidden -n _dummy
hid="$(tmux break-pane -d -P -F '#{window_id}' -s "$cur")"
tmux move-window -d -s "$hid" -t =_cctask_hidden:
tmux kill-window -t =_cctask_hidden:_dummy 2>/dev/null || true
tmux set-option -w -t "$win" "$opt" "$hid"
