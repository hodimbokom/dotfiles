#!/usr/bin/env bash
command -v jq >/dev/null || exit 0
input="$(cat)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-claude-usage"
mkdir -p "$(dirname "$cache")"

eval "$(printf '%s' "$input" | jq -r '
  def n: if . == null then "" else (tonumber | floor | tostring) end;
  "ctx=\(.context_window.used_percentage | n)",
  "h5=\(.rate_limits.five_hour.used_percentage | n)",
  "d7=\(.rate_limits.seven_day.used_percentage | n)"
')"

{
  printf 'ctx=%s\n' "$ctx"
  printf 'h5=%s\n' "$h5"
  printf 'd7=%s\n' "$d7"
} > "$cache" 2>/dev/null || true

plain=
[ -n "$ctx" ] && plain="$plain 󰧑 ${ctx}%"
[ -n "$h5" ] && plain="$plain 󰔛 ${h5}%"
[ -n "$d7" ] && plain="$plain 󰨳 ${d7}%"
printf '%s\n' "${plain# }"
