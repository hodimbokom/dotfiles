#!/usr/bin/env bash
set -eu

tag_window() {
  local win="$1" pane
  pane="$(tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_bottom} #{pane_at_left} #{pane_at_right}' \
    | awk '$2==1 && $4==1 && $5==0 { print $1; exit }')"
  [ -n "$pane" ] && tmux set-option -p -t "$pane" @cctask_role editor
  pane="$(tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_bottom} #{pane_at_left}' \
    | awk '$2==0 && $3==1 && $4==1 { print $1; exit }')"
  [ -n "$pane" ] && tmux set-option -p -t "$pane" @cctask_role shell
  pane="$(tmux list-panes -t "$win" -F '#{pane_id} #{pane_at_top} #{pane_at_right}' \
    | awk '$2==1 && $3==1 { print $1; exit }')"
  [ -n "$pane" ] && tmux set-option -p -t "$pane" @cctask_role claude
}

find_window() {
  tmux list-windows -t "=$1" -F '#{window_id} #{window_name}' 2>/dev/null \
    | awk -v want="$2" '{ id = $1; sub(/^[^ ]+ /, ""); if ($0 == want) { print id; exit } }'
}

save() {
  local file="${1:-}" tmp
  [ -n "$file" ] && [ -f "$file" ] || return 0
  tmp="$file.tmp"
  awk '
    BEGIN { FS = OFS = "\t" }
    {
      rec[++n] = $0
      kind[n] = $1
      sess[n] = $2
      widx[n] = $3
      if ($1 == "window") {
        name = $4
        sub(/^:/, "", name)
        if ($2 == "_cctask_hidden" && name ~ /^.+::.+::(editor|claude|shell)$/)
          keep[$3] = 1
        if ($2 != "0" && $2 != "_cctask_hidden" && first == "")
          first = $2
      }
    }
    END {
      for (i = 1; i <= n; i++) {
        if (kind[i] == "pane" || kind[i] == "window") {
          if (sess[i] == "0") continue
          if (sess[i] == "_cctask_hidden" && !(widx[i] in keep)) continue
        }
        if (kind[i] == "state") {
          split(rec[i], s, "\t")
          if (s[2] == "0" && first != "") s[2] = first
          if (s[3] == "0" && first != "") s[3] = first
          print s[1], s[2], s[3]
          continue
        }
        print rec[i]
      }
    }
  ' "$file" > "$tmp"
  if grep -q '^pane' "$tmp"; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
  fi
}

unpark() {
  tmux has-session -t=_cctask_hidden 2>/dev/null || return 0
  tmux list-windows -t =_cctask_hidden -F '#{window_id} #{window_name}' 2>/dev/null \
    | while read -r hid name; do
        case "$name" in
          *::*::*) ;;
          *) tmux kill-window -t "$hid" 2>/dev/null || true; continue ;;
        esac
        sess="${name%%::*}"
        role="${name##*::}"
        wname="${name#*::}"
        wname="${wname%::*}"
        case "$role" in
          editor|claude|shell) ;;
          *) tmux kill-window -t "$hid" 2>/dev/null || true; continue ;;
        esac
        target="$(find_window "$sess" "$wname")"
        if [ -z "$target" ]; then
          tmux kill-window -t "$hid" 2>/dev/null || true
          continue
        fi
        case "$role" in
          editor) order=1 ;;
          claude) order=2 ;;
          shell) order=3 ;;
          *) order=9 ;;
        esac
        printf '%s %s %s %s\n' "$order" "$target" "$role" "$hid"
      done \
    | sort \
    | while read -r order target role hid; do
        tmux set-option -w -t "$target" "@cctask_${role}_hidden" "$hid"
        ~/.config/bin/tmux-pane "$target" "$role" || true
      done
  tmux has-session -t=_cctask_hidden 2>/dev/null && tmux kill-session -t=_cctask_hidden || true
}

unzoom() {
  tmux list-windows -a -F '#{window_id} #{window_zoomed_flag}' 2>/dev/null \
    | awk '$2 == 1 { print $1 }' \
    | while read -r wid; do
        tmux resize-pane -t "$wid" -Z || true
      done
}

drop_unnamed() {
  local name
  name="$(tmux display-message -t '=0' -p '#{session_name}' 2>/dev/null || true)"
  [ "$name" = "0" ] || return 0
  [ "$(tmux list-sessions 2>/dev/null | grep -c . || true)" -gt 1 ] || return 0
  tmux switch-client -n 2>/dev/null || true
  tmux kill-session -t '=0' 2>/dev/null || true
}

restore() {
  unpark
  drop_unnamed
  unzoom
  tmux list-windows -a -F '#{session_name} #{window_id} #{window_panes}' 2>/dev/null \
    | while read -r sess wid n; do
        [ "$sess" = "_cctask_hidden" ] && continue
        [ "${n:-0}" -ge 2 ] || continue
        tag_window "$wid"
      done
}

case "${1:-restore}" in
  save) save "${2:-}" ;;
  restore) restore ;;
  *)
    echo "tmux-resurrect-fix: save|restore" >&2
    exit 1
    ;;
esac
